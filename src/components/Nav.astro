---
const { currentPage } = Astro.props;

const links = [
  { href: '/',        label: 'Home' },
  { href: '/about',   label: 'About' },
  { href: '/writing', label: 'Writing' },
  { href: '/contact', label: 'Contact' },
];
---

<nav class="nav">
  <ul class="nav__links">
    {links.map(link => (
      <li>
        <a
          href={link.href}
          class={currentPage === link.href ? 'active' : ''}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const delays = [0, 80, 160, 240, 320];
  document.querySelectorAll('.nav__links a').forEach((link, i) => {
    setTimeout(() => link.classList.add('nav-visible'), delays[i] ?? 320);
  });
</script>
