---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const posts = await getCollection('blog');

posts.sort((a, b) => parseDate(b.data.date).getTime() - parseDate(a.data.date).getTime());

const byYear: Record<number, typeof posts> = {};
for (const post of posts) {
  const year = parseDate(post.data.date).getFullYear();
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(post);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

// Parse "Sat 11th Oct 2025" or ISO strings
function parseDate(str: string): Date {
  const cleaned = str.replace(/(\d+)(st|nd|rd|th)/, '$1');
  return new Date(cleaned);
}

function formatDate(str: string): string {
  const d = parseDate(str);
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
}

const rendered = await Promise.all(
  posts.map(async post => {
    const { Content } = await render(post);
    return { id: post.id, Content };
  })
);
const contentMap = Object.fromEntries(rendered.map(r => [r.id, r.Content]));
---

<Base title="Writing" currentPage="/writing">
  <div class="page-content">
    <h1 class="page-heading">Writing</h1>

    {years.map(year => (
      <div>
        <div class="writing-year">{year}</div>
        <ul class="writing-list">
          {byYear[year].map(post => {
            const Content = contentMap[post.id];
            const toggleId = `post-${post.id.replace(/[^a-z0-9]/gi, '-')}`;
            return (
              <li>
                <div class="writing-entry">
                  <span class="writing-entry__date">{formatDate(post.data.date)}</span>
                  <span class="writing-entry__title">{post.data.title}</span>
                  <button
                    class="writing-entry__toggle"
                    aria-expanded="false"
                    aria-controls={toggleId}
                    data-toggle
                  >+</button>
                </div>
                <div class="writing-body" id={toggleId} role="region">
                  <div class="writing-body__inner">
                    {post.data.image && (
                      <img
                        class="writing-body__image"
                        src={post.data.image}
                        alt=""
                        loading="lazy"
                        width="680"
                        height="360"
                      />
                    )}
                    <span class="writing-body__tag">{post.data.category}</span>
                    <div class="writing-body__content">
                      <Content />
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</Base>

<script>
  // ─── Step 4: Scroll-triggered fade-up ───────────────────────
  const entries = document.querySelectorAll('.writing-list li');
  entries.forEach(el => {
    (el as HTMLElement).style.opacity = '0';
    (el as HTMLElement).style.transform = 'translateY(16px)';
    (el as HTMLElement).style.transition = 'opacity 0.4s ease, transform 0.4s ease';
  });

  const observer = new IntersectionObserver((observed) => {
    observed.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const allEntries = Array.from(entries);
        const idx = allEntries.indexOf(el);
        const delay = Math.min(idx * 60, 300);
        setTimeout(() => {
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        }, delay);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.1 });

  entries.forEach(el => observer.observe(el));

  // ─── Toggle ──────────────────────────────────────────────────
  function activateToggle(btn: HTMLElement) {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    const targetId = btn.getAttribute('aria-controls')!;
    const body = document.getElementById(targetId) as HTMLElement | null;
    if (!body) return;
    if (!expanded) {
      body.style.maxHeight = body.scrollHeight + 'px';
    } else {
      body.style.maxHeight = '0';
    }
  }

  // + button
  document.querySelectorAll('[data-toggle]').forEach(btn => {
    btn.addEventListener('click', () => activateToggle(btn as HTMLElement));
  });

  // Title text
  document.querySelectorAll('.writing-entry__title').forEach(title => {
    title.addEventListener('click', () => {
      const btn = title.closest('.writing-entry')?.querySelector('[data-toggle]') as HTMLElement | null;
      if (btn) activateToggle(btn);
    });
  });
</script>
