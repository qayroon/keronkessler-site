---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" currentPage="/contact">
  <div class="page-content">
    <h1 class="page-heading">Get in touch</h1>

    <p class="contact-intro">
      I'm always glad to hear from people working on interesting
      things — whether that's a project, a question, or just
      something worth talking about. I tend to reply within a
      few days.
    </p>
    <p class="contact-intro">
      And if you're ever in Munich — I'm always up for a coffee
      or a good soft drink.
    </p>

    <div class="contact-links">
      <div class="contact-item">
        <span class="contact-item__label">Mail</span>
        <a class="contact-link--email" href="mailto:hi@keronkessler.com">
          hi@keronkessler.com
        </a>
      </div>
      <div class="contact-item">
        <span class="contact-item__label">LinkedIn</span>
        <a
          class="contact-link--linkedin"
          href="https://linkedin.com/in/keronkessler"
          target="_blank"
          rel="noopener noreferrer"
        >
          linkedin.com/in/keronkessler
        </a>
      </div>
    </div>

  </div>
</Base>
