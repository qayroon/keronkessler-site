---
import Base from '../layouts/Base.astro';
---

<Base title="404" currentPage="">
  <div class="not-found">
    <span class="not-found__backdrop" aria-hidden="true">404</span>
    <div class="not-found__content">
      <h1 class="not-found__heading">404</h1>
      <p class="not-found__quote">
        "Not all those who wander are lost — but you definitely are."
      </p>
      <p class="not-found__attribution">— not Tolkien</p>
      <a href="/" class="not-found__link">← Back to home</a>
    </div>
  </div>
</Base>
